# CCE environment configuration. Copy to .env (gitignored).
# Precedence: environment variable > YAML config file > built-in default.
# Optional vars are commented out with their defaults shown; comments sit on
# their own line because the .env loader does not strip inline comments.
# Full guide: docs/configuration.md

# --- Required — the pipeline will not run without these ---
ANTHROPIC_API_KEY=sk-ant-...
FIRECRAWL_API_KEY=fc-...

# --- LLM ---
# LLM provider id (only "anthropic" is implemented)
# CCE_LLM_PROVIDER=anthropic
# Model id for writer + verifier calls
# CCE_LLM_MODEL=claude-sonnet-4-6
# Fallback alias for CCE_LLM_MODEL (CCE_LLM_MODEL wins when both are set)
# ANTHROPIC_MODEL=claude-sonnet-4-6
# Overrides ANTHROPIC_API_KEY when set
# CCE_LLM_API_KEY=sk-ant-...
# Sampling temperature
# CCE_LLM_TEMPERATURE=0.2
# Per-call output token cap
# CCE_LLM_MAX_TOKENS=4096

# --- Evidence store ---
# Storage backend (only "sqlite" is implemented)
# CCE_EVIDENCE_BACKEND=sqlite
# SQLite file path (also holds jobs and API keys)
# CCE_EVIDENCE_SQLITE_PATH=evidence.db

# --- Crawl ---
# Crawl adapter id (only "firecrawl" is implemented)
# CCE_CRAWL_ADAPTER=firecrawl
# Overrides FIRECRAWL_API_KEY when set
# CCE_CRAWL_API_KEY=fc-...
# Max crawl requests per second
# CCE_CRAWL_RATE_LIMIT=2.0
# Per-request crawl timeout (seconds)
# CCE_CRAWL_TIMEOUT=30
# Max evidence excerpts kept per source
# CCE_CRAWL_MAX_PER_SOURCE=5
# Max evidence objects kept per curation request
# CCE_CRAWL_MAX_EVIDENCE=100

# --- Embedding ranking (Ollama; see docs/configuration.md) ---
# Set false to skip Ollama and fall back to keyword ranking
# CCE_EMBEDDING_ENABLED=true
# Embedding provider id (only "ollama" is implemented)
# CCE_EMBEDDING_PROVIDER=ollama
# Model the Ollama server must have pulled
# CCE_EMBEDDING_MODEL=nomic-embed-text-v2-moe
# Embedding vector dimensions
# CCE_EMBEDDING_DIMENSIONS=768
# Ollama server URL
# CCE_EMBEDDING_BASE_URL=http://localhost:11434
# Per-batch embedding timeout (seconds)
# CCE_EMBEDDING_TIMEOUT=30
# Texts per embedding request
# CCE_EMBEDDING_BATCH_SIZE=64

# --- API server (`cce api start`) ---
# Bind address
# CCE_API_HOST=0.0.0.0
# Bind port
# CCE_API_PORT=8000
# Set false to disable bearer-token auth (local dev only)
# CCE_API_REQUIRE_AUTH=true
# Comma-separated allowed CORS origins
# CCE_API_CORS_ORIGINS=*
# Max pipeline jobs the API runs in parallel
# CCE_API_MAX_CONCURRENT_JOBS=2

# --- Job budget ---
# Hard ceiling on accumulated LLM tokens (input + output, all paths and
# iterations) per job. On breach the job stops iterating and routes to
# REVIEW_REQUIRED, keeping partial drafts (ADR-003). Unset = unlimited.
# CCE_MAX_TOKENS_PER_JOB=400000

# --- Humanization (off by default; thresholds are tuned in YAML) ---
# Master switch for the scorer / editor / implied-claim checker
# CCE_HUMANIZATION_ENABLED=false
# Marker-list YAML (operator-editable)
# CCE_HUMANIZATION_MARKERS_PATH=config/humanization_markers.yaml

# --- Logging ---
# "json" switches to structured JSON logs; unset = plain text
# CCE_LOG_FORMAT=json
